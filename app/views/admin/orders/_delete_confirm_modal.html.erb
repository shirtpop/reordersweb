<div data-delete-confirm-target="modal"
     class="hidden fixed inset-0 z-[90] flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-gray-900/60" data-action="click->delete-confirm#close"></div>

  <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl max-w-md w-full p-6">
    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">Delete order <%= order.order_number %>?</h3>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
      This permanently removes the order and everything listed below. This cannot be undone.
    </p>

    <dl class="space-y-2 text-sm mb-4 bg-gray-50 dark:bg-gray-900 rounded-xl p-4">
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500 dark:text-gray-400">Status</dt>
        <dd class="font-medium text-gray-900 dark:text-white text-right capitalize"><%= order.status %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500 dark:text-gray-400">Order items</dt>
        <dd class="font-medium text-gray-900 dark:text-white text-right"><%= pluralize(order.order_items.count, "item") %></dd>
      </div>
      <% if inventory_movements_count.to_i.positive? %>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-500 dark:text-gray-400">Inventory records</dt>
          <dd class="font-medium text-red-600 dark:text-red-400 text-right"><%= pluralize(inventory_movements_count, "movement") %></dd>
        </div>
      <% end %>
    </dl>

    <% if inventory_movements_count.to_i.positive? %>
      <p class="text-xs text-red-600 dark:text-red-400 mb-4">
        This order has already affected inventory. Deleting it removes those inventory records too, without adjusting stock counts back.
      </p>
    <% end %>

    <div class="flex items-center gap-3">
      <button type="button" data-action="click->delete-confirm#close"
              class="flex-1 px-4 py-2.5 rounded-xl font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors">
        Cancel
      </button>
      <%= button_to "Delete Anyway", admin_order_path(order), method: :delete,
          class: "flex-1 px-4 py-2.5 rounded-xl font-bold text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors" %>
    </div>
  </div>
</div>
