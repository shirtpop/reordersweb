<div id="user_row_<%= user.id %>" class="flex items-center justify-between p-4"<% if user.client&.demo? && !user.active? %> data-controller="activate-trial"<% end %>>
  <div class="flex items-center">
    <div class="h-8 w-8 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center flex-shrink-0">
      <span class="text-sm font-medium text-blue-600 dark:text-blue-300"><%= user.email.first.upcase %></span>
    </div>
    <div class="ml-3">
      <p class="text-sm font-medium text-gray-900 dark:text-white">
        <%= user.full_name.presence || "(no name set)" %>
      </p>
      <p class="text-xs text-gray-500 dark:text-gray-400">
        <!--email_off--><%= user.email %><!--/email_off--> &middot;
        <%= user.role&.humanize || 'Client' %>
        <% if user.last_sign_in_at %>
          &middot; Last signed in <%= time_ago_in_words(user.last_sign_in_at) %> ago
        <% end %>
      </p>
    </div>
  </div>
  <div class="flex items-center space-x-3">
    <% if user.role_client? %>
      <%= link_to "Login as",
          masquerade_path(user),
          title: "Login as this user",
          data: { turbo_frame: "_top" },
          class: "px-3 py-1 border border-gray-300 dark:border-gray-500 rounded-md text-xs font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600" %>
    <% end %>
    <% if user.active? %>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">
        Active
      </span>
    <% else %>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-200 text-gray-700 dark:bg-gray-600 dark:text-gray-300">
        Inactive
      </span>
      <% if user.client&.demo? %>
        <button type="button" data-action="click->activate-trial#open"
                class="px-3 py-1 border border-transparent rounded-md text-xs font-medium text-white bg-blue-600 hover:bg-blue-700">
          Activate
        </button>
      <% else %>
        <%= button_to "Activate", activate_admin_user_path(user), method: :patch,
            class: "px-3 py-1 border border-transparent rounded-md text-xs font-medium text-white bg-blue-600 hover:bg-blue-700",
            form: { data: { turbo_confirm: "Activate #{user.email} and email them their login credentials?" } } %>
      <% end %>
    <% end %>
  </div>

  <% if user.client&.demo? && !user.active? %>
    <div data-activate-trial-target="modal"
         class="hidden fixed inset-0 z-[90] flex items-center justify-center p-4">
      <div class="absolute inset-0 bg-gray-900/60" data-action="click->activate-trial#close"></div>

      <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl max-w-md w-full p-6">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">Activate trial user</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          This is a trial account, so no email is sent. Set a password below and hand it off
          to <!--email_off--><%= user.email %><!--/email_off--> directly.
        </p>

        <%= form_with url: activate_admin_user_path(user), method: :patch do |form| %>
          <div class="mb-4">
            <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
            <%= form.password_field :password, required: true, minlength: 6, autocomplete: "new-password",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>

          <div class="flex items-center gap-3">
            <button type="button" data-action="click->activate-trial#close"
                    class="flex-1 px-4 py-2.5 rounded-xl font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors">
              Cancel
            </button>
            <button type="submit"
                    class="flex-1 px-4 py-2.5 rounded-xl font-bold text-white bg-blue-600 hover:bg-blue-700 transition-colors">
              Activate
            </button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
