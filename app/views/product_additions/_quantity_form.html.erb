<%= link_to new_product_addition_path, class: "inline-flex items-center gap-1 text-sm font-medium text-pink-600 hover:text-pink-700 mb-6" do %>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
  </svg>
  Choose a different product
<% end %>

<h2 class="text-2xl font-bold text-gray-900 mb-1"><%= product.name %></h2>
<p class="text-gray-600 mb-6">Enter the quantity you currently have on hand for each size and color. Leave a field blank to skip it — you can add stock for it later.</p>

<%= form_with url: product_additions_path, method: :post, local: true, class: "space-y-6" do %>
  <%= hidden_field_tag :product_id, product.id %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% product.product_colors.each_with_index do |color, color_idx| %>
      <div class="rounded-xl border-2 border-gray-200 p-4">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-4 h-4 rounded-full border border-gray-200" style="background-color: <%= color.hex_color %>"></div>
          <span class="text-sm font-semibold text-gray-900"><%= color.name.capitalize %></span>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <% product.sizes.each_with_index do |size, size_idx| %>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1"><%= size %></label>
              <%= number_field_tag "variants[#{size_idx}_#{color_idx}][quantity]", nil,
                  min: 0, placeholder: "0",
                  class: "w-full px-2 py-1.5 text-sm text-center border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-200 focus:border-pink-400" %>
              <%= hidden_field_tag "variants[#{size_idx}_#{color_idx}][size]", size %>
              <%= hidden_field_tag "variants[#{size_idx}_#{color_idx}][color]", color.name %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex justify-end">
    <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-pink-600 to-rose-600 rounded-xl hover:from-pink-700 hover:to-rose-700 shadow-md hover:shadow-lg transition-all duration-200">
      Add to Inventory
    </button>
  </div>
<% end %>
