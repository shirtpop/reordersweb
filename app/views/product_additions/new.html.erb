<div class="container mx-auto px-4 py-8 max-w-7xl">
  <div class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl lg:text-4xl font-bold mb-2 bg-gradient-to-r from-gray-900 via-pink-800 to-gray-900 bg-clip-text text-transparent">
          Add Shirtpop Product
        </h1>
        <p class="text-lg text-gray-600">
          Add stock for a product already assigned to you, without placing an order.
        </p>
      </div>
      <%= link_to products_path,
          class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 bg-white border-2 border-gray-200 hover:border-pink-300 hover:text-pink-700 transition-all duration-200 self-start" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Products
      <% end %>
    </div>

    <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 overflow-hidden">
      <div class="p-6 md:p-8">
        <% if @product %>
          <%= render "quantity_form", product: @product %>
        <% else %>
          <%= render "picker", addable_products: @addable_products %>
        <% end %>
      </div>
    </div>
  </div>
</div>
